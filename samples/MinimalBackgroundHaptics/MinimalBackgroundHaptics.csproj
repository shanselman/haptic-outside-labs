<Project Sdk="Microsoft.NET.Sdk">
  <!-- Standalone ~150-line sample of the trick EXP-020 proved. No dependency on the lab.
       Directory.Build.props supplies WindowsSdkPackageVersion=10.0.28000.87 (InputHapticsManager). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>minimal-background-haptics</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
</Project>
