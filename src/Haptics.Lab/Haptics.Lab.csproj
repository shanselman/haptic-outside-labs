<Project Sdk="Microsoft.NET.Sdk">
  <!-- Haptics Everywhere Showcase + Lab: showcase UI, inspector, CLI, experiment runners, fixtures.
       WPF is enabled only to host a real WPF Slider (it exposes RangeValue, so slider detents can be felt). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <AssemblyName>haptics-lab</AssemblyName>
    <RootNamespace>Haptics.Lab</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Haptics.Core\Haptics.Core.csproj" />
    <ProjectReference Include="..\Haptics.Windows\Haptics.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>
</Project>
