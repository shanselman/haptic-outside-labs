<UserControl
    x:Class="Haptics.Lab.ShowcaseDemo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <!-- Keep GroupBox's UIA group semantics; only replace the legacy etched outline. -->
        <Style TargetType="GroupBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border CornerRadius="6" BorderThickness="1" Padding="{TemplateBinding Padding}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <StackPanel>
                                <ContentPresenter ContentSource="Header" Margin="0,0,0,8"
                                                  TextElement.FontSize="12" TextElement.FontWeight="SemiBold" />
                                <ContentPresenter />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Style="{DynamicResource Section}" Margin="0,0,0,8" Text="Menus &amp; toolbars" />
        <TextBlock Style="{DynamicResource Hint}" Margin="0,0,0,8" Text="A detent when you enter. A land on each command. Slide off the end for an edge." />
        <Menu AutomationProperties.Name="Demo menu" HorizontalAlignment="Left">
            <MenuItem Header="_File">
                <MenuItem Header="_New" /><MenuItem Header="_Open" /><MenuItem Header="_Save" /><Separator /><MenuItem Header="_Print" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" /><Separator /><MenuItem Header="Cu_t" /><MenuItem Header="_Copy" /><MenuItem Header="_Paste" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Zoom _in" /><MenuItem Header="Zoom _out" /><MenuItem Header="_Full screen" />
            </MenuItem>
        </Menu>
        <ToolBar Margin="0,8,0,0" HorizontalAlignment="Left" ToolBarTray.IsLocked="True" AutomationProperties.Name="Formatting toolbar">
            <ToggleButton Content="B" FontWeight="Bold" Width="36" Height="32" AutomationProperties.Name="Bold" />
            <ToggleButton Content="I" FontStyle="Italic" Width="36" Height="32" AutomationProperties.Name="Italic" />
            <ToggleButton Width="36" Height="32" AutomationProperties.Name="Underline"><TextBlock Text="U" TextDecorations="Underline" /></ToggleButton>
            <Separator />
            <Button Content="←" Width="36" Height="32" AutomationProperties.Name="Previous" />
            <Button Content="→" Width="36" Height="32" AutomationProperties.Name="Next" />
            <Separator />
            <Button Content="+" Width="36" Height="32" AutomationProperties.Name="Zoom in" />
            <Button Content="−" Width="36" Height="32" AutomationProperties.Name="Zoom out" />
        </ToolBar>

        <TextBlock Style="{DynamicResource Section}" Text="A little ribbon" />
        <TextBlock Style="{DynamicResource Hint}" Margin="0,0,0,8" Text="Each group is a region. Big buttons have a firmer landing." />
        <WrapPanel>
            <GroupBox Header="Clipboard" Margin="0,0,8,8" Padding="8">
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="Paste" Width="64" Height="88" Margin="0,0,6,0" />
                    <StackPanel VerticalAlignment="Center">
                        <ui:Button Content="Cut" Width="68" Margin="0,0,0,4" />
                        <ui:Button Content="Copy" Width="68" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Insert" Margin="0,0,8,8" Padding="8">
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="Picture" Width="64" Height="88" Margin="0,0,6,0" />
                    <StackPanel VerticalAlignment="Center">
                        <ui:Button Content="Table" Width="68" Margin="0,0,0,4" />
                        <ui:Button Content="Shape" Width="68" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Share" Margin="0,0,0,8" Padding="8">
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="Send" Width="64" Height="88" Margin="0,0,6,0" />
                    <StackPanel VerticalAlignment="Center">
                        <ui:Button Content="Link" Width="68" Margin="0,0,0,4" />
                        <ui:Button Content="Export" Width="68" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </WrapPanel>

        <TextBlock Style="{DynamicResource Section}" Text="Tabs &amp; choices" />
        <TextBlock Style="{DynamicResource Hint}" Margin="0,0,0,8" Text="A detent per tab or option. The selected tab stays silent; checkboxes land." />
        <TabControl x:Name="DemoTabs" AutomationProperties.Name="Demo tabs">
            <TabItem Header="Home" IsSelected="True" /><TabItem Header="Insert" /><TabItem Header="Design" />
            <TabItem Header="Review" /><TabItem Header="View" />
        </TabControl>
        <GroupBox Header="Size" Padding="12" Margin="0,8,0,0">
            <WrapPanel>
                <RadioButton Content="Small" GroupName="Size" Margin="0,0,16,8" />
                <RadioButton Content="Medium" GroupName="Size" IsChecked="True" Margin="0,0,16,8" />
                <RadioButton Content="Large" GroupName="Size" Margin="0,0,24,8" />
                <CheckBox Content="Bold" Margin="0,0,16,8" />
                <CheckBox Content="Italic" Margin="0,0,0,8" />
            </WrapPanel>
        </GroupBox>

        <TextBlock Style="{DynamicResource Section}" Text="Find the edges" />
        <TextBlock Style="{DynamicResource Hint}" Margin="0,0,0,8" Text="Hold and drag: a detent every 10, an edge at either end. Keyboard changes stay silent." />
        <Slider x:Name="DemoSlider" Minimum="0" Maximum="100" Value="50" SmallChange="1" LargeChange="10"
                TickFrequency="10" TickPlacement="BottomRight" AutomationProperties.Name="Demo slider" />

        <TextBlock Style="{DynamicResource Section}" Text="Silent, on purpose" />
        <TextBlock Style="{DynamicResource Hint}" Margin="0,0,0,8" Text="Tiny targets, disabled controls, passwords and painted surfaces don't earn a pulse." />
        <WrapPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Margin="0,0,12,8" VerticalAlignment="Center">
                <Button Width="9" Height="9" MinWidth="0" MinHeight="0" Padding="0" Margin="2" AutomationProperties.Name="Tiny target 1" />
                <Button Width="9" Height="9" MinWidth="0" MinHeight="0" Padding="0" Margin="2" AutomationProperties.Name="Tiny target 2" />
                <Button Width="9" Height="9" MinWidth="0" MinHeight="0" Padding="0" Margin="2" AutomationProperties.Name="Tiny target 3" />
                <Button Width="9" Height="9" MinWidth="0" MinHeight="0" Padding="0" Margin="2" AutomationProperties.Name="Tiny target 4" />
            </StackPanel>
            <ui:Button Content="Disabled" IsEnabled="False" Margin="0,0,8,8" />
            <PasswordBox x:Name="DemoPassword" Width="110" Margin="0,0,8,8" AutomationProperties.Name="Demo password field" />
            <Border Padding="12,8" CornerRadius="4" Margin="0,0,0,8" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                <TextBlock Text="Painted 'button'" IsHitTestVisible="False" />
            </Border>
        </WrapPanel>
    </StackPanel>
</UserControl>
