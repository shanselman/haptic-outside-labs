<Project Sdk="Microsoft.NET.Sdk">
  <!-- Haptics Everywhere tray app. Imports only production modules (Core + Windows) plus WPF-UI (MIT) for the
       Windows 11 look of the settings window. Must never reference fixtures, test automation, SendInput, or UIA
       action patterns. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <AssemblyName>haptics-tray</AssemblyName>
    <RootNamespace>Haptics.Tray</RootNamespace>
    <ApplicationManifest>..\Haptics.Lab\app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Haptics.Core\Haptics.Core.csproj" />
    <ProjectReference Include="..\Haptics.Windows\Haptics.Windows.csproj" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <EmbeddedResource Include="..\..\assets\app.ico" LogicalName="app.ico" />
    <InternalsVisibleTo Include="Haptics.Windows.Tests" />
    <!-- UseWPF drops the implicit System.IO using. -->
    <Using Include="System.IO" />
  </ItemGroup>
</Project>
