<ui:FluentWindow
    x:Class="Haptics.Tray.SettingsWindow"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Haptics Everywhere"
    Width="540"
    Height="780"
    MinWidth="460"
    MinHeight="480"
    ExtendsContentIntoTitleBar="True"
    RenderOptions.BitmapScalingMode="HighQuality"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="AppTitleBar"
            Title="Haptics Everywhere"
            CloseWindowByDoubleClickOnIcon="True"
            ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon x:Name="TitleIcon" Width="16" Height="16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,4,24,24">
                <Border
                    Padding="20"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image
                            x:Name="HeroImage"
                            Width="64"
                            Height="64"
                            VerticalAlignment="Top" />
                        <StackPanel
                            Grid.Column="1"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse
                                    x:Name="StatusDot"
                                    Width="10"
                                    Height="10"
                                    Margin="0,1,10,0"
                                    VerticalAlignment="Center" />
                                <ui:TextBlock
                                    x:Name="StatusText"
                                    Grid.Column="1"
                                    FontTypography="Subtitle"
                                    TextWrapping="Wrap" />
                            </Grid>
                            <ui:TextBlock
                                x:Name="StatusHint"
                                Margin="0,6,0,0"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ui:TextBlock Margin="2,24,0,8" FontTypography="BodyStrong" Text="Feel" />
                <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon CursorClick24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="Haptics" />
                            <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" TextWrapping="Wrap" Text="Feel the controls under your mouse or touchpad, in any app" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="EnabledSwitch" AutomationProperties.Name="Haptics" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Options24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="Style" />
                            <ui:TextBlock x:Name="StyleHint" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox
                        x:Name="StyleBox"
                        MinWidth="150"
                        AutomationProperties.Name="Style" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon TopSpeed24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="Intensity" />
                            <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" TextWrapping="Wrap" Text="How strong each pulse is" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock
                            x:Name="IntensityLabel"
                            Width="52"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            TextAlignment="Right" />
                        <Slider
                            x:Name="IntensitySlider"
                            Width="150"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Intensity"
                            IsSnapToTickEnabled="True"
                            Maximum="1"
                            Minimum="0.3"
                            Ticks="0.3,0.55,0.8,1" />
                    </StackPanel>
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Dismiss24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="Close button hover" />
                            <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" TextWrapping="Wrap" Text="A light tick when you land on a window's Close button. Silent in Quiet style." />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="CloseHoverSwitch" AutomationProperties.Name="Close button hover" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Laptop24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="Boost touchpad" />
                            <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" TextWrapping="Wrap" Text="Touchpads feel lighter than mice at the same intensity" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="BoostSwitch" AutomationProperties.Name="Boost touchpad" />
                </ui:CardControl>

                <ui:TextBlock Margin="2,24,0,8" FontTypography="BodyStrong" Text="Apps and startup" />
                <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon PlugConnected24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="Let apps send haptics" />
                            <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" TextWrapping="Wrap" Text="Apps you run can ask for a pulse, like when a snap guide appears" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="CooperationSwitch" AutomationProperties.Name="Let apps send haptics" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Rocket24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="Start with Windows" />
                            <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" TextWrapping="Wrap" Text="Ready whenever you sign in" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="StartupSwitch" AutomationProperties.Name="Start with Windows" />
                </ui:CardControl>
                <ui:CardExpander Margin="0,0,0,4" ContentPadding="16" Icon="{ui:SymbolIcon Prohibited24}">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="Excluded apps" />
                            <ui:TextBlock x:Name="ExcludedSummary" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <StackPanel x:Name="ExcludedList" />
                        <ui:Button
                            x:Name="ExcludeButton"
                            Margin="0,8,0,0"
                            Icon="{ui:SymbolIcon Add24}"
                            ToolTip="The app you used before opening this window" />
                        <ui:TextBlock
                            Margin="0,12,0,0"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            FontTypography="Caption"
                            TextWrapping="Wrap"
                            Text="Password fields, password managers and sign-in screens are always silent." />
                    </StackPanel>
                </ui:CardExpander>

                <ui:CardExpander
                    Margin="0,20,0,0"
                    ContentPadding="16"
                    Icon="{ui:SymbolIcon DataUsage24}">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="Details" />
                            <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Caption" TextWrapping="Wrap" Text="What the engine is doing right now" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock
                            x:Name="StatsText"
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <ui:TextBlock
                            Margin="0,12,0,0"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            FontTypography="Caption"
                            TextWrapping="Wrap"
                            Text="Counts show what Windows accepted, not proof that you felt a pulse." />
                    </StackPanel>
                </ui:CardExpander>

                <WrapPanel Margin="-12,20,0,0">
                    <ui:HyperlinkButton
                        Content="Send feedback"
                        Icon="{ui:SymbolIcon PersonFeedback24}"
                        NavigateUri="https://github.com/shanselman/haptic-outside-labs/issues/new?template=tester-report.yml" />
                    <ui:HyperlinkButton
                        Content="Releases"
                        Icon="{ui:SymbolIcon ArrowDownload24}"
                        NavigateUri="https://github.com/shanselman/haptic-outside-labs/releases" />
                    <ui:HyperlinkButton
                        Content="Privacy"
                        Icon="{ui:SymbolIcon ShieldCheckmark24}"
                        NavigateUri="https://github.com/shanselman/haptic-outside-labs/blob/main/docs/PRIVACY_AND_THREAT_MODEL.md" />
                    <ui:HyperlinkButton
                        x:Name="ShowcaseButton"
                        Content="Open Showcase"
                        Icon="{ui:SymbolIcon Open24}" />
                </WrapPanel>
                <ui:TextBlock
                    x:Name="VersionText"
                    Margin="0,12,0,0"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    FontTypography="Caption" />
                <ui:TextBlock
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    FontTypography="Caption"
                    Text="Closing this window keeps haptics running in the tray. Right-click the tray icon to quit."
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
